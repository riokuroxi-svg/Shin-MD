# ════════════════════════════════════════════════
#  Shin-MD — Configuración de entorno
#  Copia este archivo a .env y rellena tus datos
# ════════════════════════════════════════════════

# Dueño del bot (solo dígitos, sin + ni espacios)
# Ejemplo: México → 525574370309
OWNER_NUMBER=525574370309
# Nombre que se muestra en .owner
OWNER_NAME=反魂

# ── Conexión ──────────────────────────────────
# Método de vinculación: 'code' para pairing, 'qr' para QR
PAIRING_METHOD=code
# Número para pairing (solo dígitos, sin +)
PAIRING_NUMBER=

# ── Logging ───────────────────────────────────
# Niveles: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ── Servidor ──────────────────────────────────
PORT=3000
# Poner LOOPBACK=0 para exponer el panel en la red
LOOPBACK=1
# ⚠️ OBLIGATORIO si LOOPBACK=0: contraseña del panel web (usuario: admin).
# Sin ella el panel vuelve a 127.0.0.1 automáticamente (failsafe).
# PANEL_PASSWORD=pon_aqui_una_clave_larga

# ── Logs ──────────────────────────────────────
# El bot guarda logs en logs/shin-YYYY-MM-DD.log (rotación diaria, 7 días)
# para poder debuggear desconexiones/bans. Pon LOG_FILE=0 para apagarlo.
# LOG_FILE=0

# ── Menú ──────────────────────────────────────
# URL opcional de imagen de banner para el menú
MENU_IMAGE=

# Estilo del menú: auto = tarjeta nativa con botones y lista desplegable
# (con fallback a texto si algo falla) · text = menú clásico de texto.
MENU_STYLE=auto

# ⚠️ RIESGO DE BAN — dejar en 0 salvo que sepas lo que haces.
# Con 1 añade "reenviado muchas veces" + tag de canal a los mensajes con
# tag verde (trucos estéticos de los bots indonesios; señal detectable).
RICH_EXTRA=0

# ── Descargas (.play) ─────────────────────────
# URL de tu API de conversión YouTube→MP3. Debe incluir {url}
# (y {key} si usa API key). Si la dejas vacía, usa fallbacks públicos.
# Ejemplo: https://tu-api.com/ytmp3?url={url}&apikey={key}
YT_API_URL=
# API key (opcional) que se sustituye en {key}
YT_API_KEY=

# Activar descarga directa con ytdl-core (puro Node.js, sin binarios).
# Útil si las APIs externas no funcionan. Requiere Node >= 18.
# TIP: si la IP de tu servidor está bloqueada por YouTube, sube tus
# cookies con el comando .subircookies (usa cuenta secundaria); este
# modo las usa automáticamente.
YTDL_ENABLED=0

# Ruta alternativa del archivo de cookies (por defecto ./cookies.txt)
# COOKIES_FILE=./cookies.txt

# ── API de Redes Sociales (FastSaver) ─────────
# Key GRATIS de api.fastsaver.io (1,000 créditos/mes, sin tarjeta).
# Hace funcionar: .instagram, .twitter, .pinterest y más.
# Regístrate en: https://api.fastsaver.io
# FASTSAVER_KEY=fs_sk_tu_key_aqui

# ── Stickers ──────────────────────────────────
# Nombre del pack de stickers (se muestra en la info del sticker)
STICKER_PACK=Shin-MD
# Autor del sticker
STICKER_AUTHOR=@ShinBot

# ── Perfil del número (anti-ban) ──────────────
# nuevo    = delay base 1500ms + warm-up de 7 días (números recién vinculados)
# veterano = delay base 700ms  + warm-up de 2 días (números con historia)
# auto     = elige solo: nuevo si llevas <7 días con el bot, veterano si no.
# Si no lo tocas, deja 'auto'.
NUMBER_PROFILE=auto

# ── Prefijo de comandos ───────────────────────
BOT_PREFIX=.