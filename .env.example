# ════════════════════════════════════════════════
#  Shin-MD — Configuración de entorno
#  Copia este archivo a .env y rellena tus datos
# ════════════════════════════════════════════════

# Dueño del bot (solo dígitos, sin + ni espacios)
# Ejemplo: México → 525574370309
OWNER_NUMBER=525574370309

# ── Conexión ──────────────────────────────────
# Método de vinculación: 'code' para pairing, 'qr' para QR
PAIRING_METHOD=code
# Número para pairing (solo dígitos, sin +)
PAIRING_NUMBER=

# ── APIs externas ─────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Logging ───────────────────────────────────
# Niveles: debug | info | warn | error | silent
LOG_LEVEL=info

# ── Rate limiting ─────────────────────────────
# Delay entre mensajes (ms)
RATE_DELAY_MS=800
# Máximo de mensajes por minuto
RATE_MAX_PER_MINUTE=60

# ── Servidor ──────────────────────────────────
PORT=3000