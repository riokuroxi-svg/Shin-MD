{
  "name": "shin-md",
  "version": "3.0.3",
  "license": "AGPL-3.0-only",
  "author": "riokuroxi-svg (github.com/riokuroxi-svg/Shin-MD)",
  "description": "反魂 Shin-MD — Bot WhatsApp Multi-Device Superior. Anti-ban nativo, auto-healing, eficiente en recursos.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:code": "node index.js --code",
    "start:qr": "node index.js --qr",
    "test": "node scripts/run-tests.mjs",
    "postinstall": "node scripts/patch-baileys-pairing.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,cjs,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,json,yml,yaml}\"",
    "typecheck": "tsc",
    "test:pairing": "node scripts/verificar-pairing.js",
    "docs:web": "node scripts/actualizar-web.mjs"
  },
  "imports": {
    "#engine": "./src/core/engine.js",
    "#socket": "./src/core/socket.js",
    "#metaCache": "./src/core/metaCache.js",
    "#serialize": "./src/serialize.js",
    "#auth": "./src/core/auth.js",
    "#queue": "./src/network/queue.js",
    "#throttler": "./src/core/engine/throttler.js",
    "#health": "./src/network/health.js",
    "#logger": "./src/services/logger.js",
    "#watchdog": "./src/services/watchdog.js",
    "#db": "./src/storage/database.js",
    "#migrations": "./src/storage/migrations.js",
    "#cache": "./src/storage/cache.js",
    "#server": "./src/web/server.js",
    "#commands": "./src/commands/loader.js",
    "#router": "./src/commands/router.js",
    "#interactive": "./src/commands/interactive.js",
    "#downloader": "./src/services/downloader.js",
    "#cooldown": "./src/commands/middleware/cooldown.js",
    "#permissions": "./src/commands/middleware/permissions.js",
    "#economy": "./src/services/economy.js",
    "#events": "./cmds/events.js",
    "#core/exif": "./src/lib/exif.js",
    "#lib/*": "./src/lib/*.js"
  },
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@img/sharp-wasm32": "^0.35.4",
    "aptoide-scraper": "^1.0.1",
    "awesome-phonenumber": "^7.8.0",
    "axios": "^1.20.0",
    "baileys": "npm:@whiskeysockets/baileys@6.7.24",
    "cfonts": "^3.3.1",
    "chalk": "4.1.2",
    "cheerio": "^1.2.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "file-type": "^21.3.4",
    "form-data": "^4.0.6",
    "grapheme-splitter": "^1.0.4",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.1",
    "mime-types": "^3.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.43",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "node-webpmux": "^3.2.1",
    "pino": "8.21.0",
    "qrcode": "1.5.4",
    "qrcode-terminal": "0.12.0",
    "readline-sync": "^1.4.10",
    "sharp": "^0.35.4",
    "syntax-error": "^1.4.0",
    "ws": "^8.21.3"
  },
  "overrides": {
    "libsignal": "npm:libsignal@6.0.0",
    "qs": "^6.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riokuroxi-svg/Shin-MD.git"
  },
  "homepage": "https://github.com/riokuroxi-svg/Shin-MD",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
